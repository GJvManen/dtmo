# Non-secret example only. Every image must be replaced with a reviewed immutable digest.
DTMO_IMAGE=ghcr.io/example/dtmo:rc@sha256:<64-hex-digest>
POSTGRES_IMAGE=postgres:17-alpine@sha256:<64-hex-digest>
REDIS_IMAGE=redis:8-alpine@sha256:<64-hex-digest>
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.6@sha256:<64-hex-digest>
AISTOR_IMAGE=quay.io/minio/aistor/minio:RELEASE.<timestamp>@sha256:<64-hex-digest>
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:<64-hex-digest>
GRAFANA_IMAGE=grafana/grafana:<supported-version>@sha256:<64-hex-digest>
NGINX_IMAGE=nginx:<supported-version>@sha256:<64-hex-digest>

POSTGRES_PASSWORD=<external-non-production-secret>
REDIS_PASSWORD=<external-non-production-secret>
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<external-non-production-secret>
AISTOR_ROOT_USER=<external-admin-user>
AISTOR_ROOT_PASSWORD=<external-admin-secret>
AISTOR_APP_ACCESS_KEY=<external-least-privilege-app-key>
AISTOR_APP_SECRET_KEY=<external-least-privilege-app-secret>
AISTOR_LICENSE_FILE=/secure/path/minio.license
AISTOR_CERTS_DIR=/secure/path/aistor-certs
DTMO_API_KEY=<external-non-production-api-key>
DTMO_JWT_JWKS_JSON=<external-non-production-jwks-json>
DTMO_JWT_ISSUER=https://identity.staging-emulator.invalid
DTMO_PRIVACY_PSEUDONYMIZATION_SECRET=<external-random-secret-at-least-32-characters>
GRAFANA_ADMIN_USER=<external-admin-user>
GRAFANA_ADMIN_PASSWORD=<external-admin-secret>
STAGING_EMULATOR_TLS_CERT=/secure/path/staging-emulator.crt
STAGING_EMULATOR_TLS_KEY=/secure/path/staging-emulator.key
STAGING_EMULATOR_HTTPS_PORT=8443
