    {
      "datasource": {"type": "prometheus", "uid": "dtmo-prometheus"},
      "description": "Bounded aggregate HTTP request rate. Route labels are server-side route templates, never raw URLs.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(rate(dtmo_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "dtmo-prometheus"},
      "description": "95th percentile HTTP latency derived from bounded route-template histograms.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(dtmo_http_request_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "dtmo-prometheus"},
