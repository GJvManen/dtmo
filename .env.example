DTMO_ENVIRONMENT=development
DTMO_LOG_LEVEL=INFO
DTMO_DATABASE_URL=postgresql+psycopg://dtmo:change-me@postgres:5432/dtmo
DTMO_REDIS_URL=redis://redis:6379/0
DTMO_OPENSEARCH_URL=http://opensearch:9200
DTMO_MINIO_ENDPOINT=minio:9000
# Local Docker Compose overrides these two API settings from MINIO_ROOT_* below
# so the development topology is internally consistent. Leave them empty here
# unless running the API directly outside Compose against a separately managed
# object-store identity.
DTMO_MINIO_ACCESS_KEY=
DTMO_MINIO_SECRET_KEY=
DTMO_MINIO_SECURE=false
DTMO_API_KEY=
DTMO_AUTH_HEADER_NAME=x-dtmo-api-key
DTMO_CONNECTOR_POLL_SECONDS=3600
DTMO_CONNECTOR_TIMEOUT_SECONDS=30
DTMO_CONNECTOR_MAX_ATTEMPTS=4
DTMO_PUBLISH_REQUIRES_HUMAN_APPROVAL=true
DTMO_FEATURE_LIVE_CONNECTORS=false
DTMO_FEATURE_OPENCVE_CONNECTOR=false
DTMO_FEATURE_VULNERABILITY_LOOKUP_CONNECTOR=false
DTMO_FEATURE_OPENCTI_READ=false
DTMO_FEATURE_AI_ANALYST=false
POSTGRES_PASSWORD=change-me

# OpenCVE API v2 uses organization API tokens with Bearer authentication.
# Keep this empty in source control and inject a read-only/catalog-read token at runtime.
DTMO_OPENCVE_API_BASE=https://app.opencve.io/api/v2
DTMO_OPENCVE_API_TOKEN=
DTMO_OPENCVE_PAGE_SIZE=20
DTMO_OPENCVE_MAX_PAGES=1

# CIRCL Vulnerability-Lookup public read endpoints do not require authentication.
# Keep the optional API token empty unless using an authenticated deployment. The
# token is runtime-only and must never be committed or written to evidence.
DTMO_VULNERABILITY_LOOKUP_API_BASE=https://vulnerability.circl.lu/api
DTMO_VULNERABILITY_LOOKUP_API_TOKEN=
DTMO_VULNERABILITY_LOOKUP_PAGE_SIZE=50
DTMO_VULNERABILITY_LOOKUP_SINCE=
DTMO_VULNERABILITY_LOOKUP_USER_AGENT=DTMO vulnerability-intelligence connector

# Phase 11.4 OpenCTI read adapter. Keep disabled unless a separately deployed
# OpenCTI service identity, least-privilege RBAC/markings and runtime secret have
# been approved. Production requires HTTPS, a runtime token, explicit entity-type
# allowlist and an absolute durable checkpoint path. No real token belongs here.
DTMO_OPENCTI_API_BASE=
DTMO_OPENCTI_API_TOKEN=
DTMO_OPENCTI_PAGE_SIZE=100
DTMO_OPENCTI_MAX_PAGES=10
DTMO_OPENCTI_ALLOWED_ENTITY_TYPES=indicator,vulnerability,malware,campaign,infrastructure,intrusion-set,threat-actor,attack-pattern
DTMO_OPENCTI_CHECKPOINT_PATH=/var/lib/dtmo/checkpoints/opencti.json

# Cisco PSIRT OpenVuln v2 uses bearer authentication. The catalog stores only
# the logical reference env:CISCO_OPENVULN_TOKEN; inject the real value at runtime.
CISCO_OPENVULN_TOKEN=

# OpenSearch 2.12+ bootstrap requires a strong initial admin password even when
# the development compose topology disables the security plugin after startup.
# Replace this placeholder locally; never commit the real value.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<external-strong-opensearch-password>

# Grafana is self-hosted with anonymous access disabled. Supply administrative
# bootstrap credentials outside source control. These are Grafana credentials,
# not DTMO application/database credentials.
GRAFANA_ADMIN_USER=<external-grafana-admin-user>
GRAFANA_ADMIN_PASSWORD=<external-strong-grafana-password>

# Dedicated PostgreSQL reader used only by Grafana. The runtime bootstrap grants
# this role SELECT on dtmo_reporting views only; it receives no table privileges
# on public intelligence, provenance, audit, privacy or quarantine data.
GRAFANA_DB_PASSWORD=<external-strong-grafana-db-reader-password>

# AIStor runtime inputs are deliberately external and have no runnable defaults.
# Resolve a vendor-supported release and verify its registry digest before use.
# Local Compose reuses this administrative identity for the API only in the
# development topology. Staging/production must keep a distinct least-privilege
# application identity (for example AISTOR_APP_ACCESS_KEY/AISTOR_APP_SECRET_KEY).
AISTOR_IMAGE=quay.io/minio/aistor/minio:RELEASE.<timestamp>@sha256:<vendor-verified-digest>
AISTOR_LICENSE_FILE=/secure/path/minio.license
MINIO_ROOT_USER=<external-admin-user>
MINIO_ROOT_PASSWORD=<external-strong-password>
